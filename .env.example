# Copie este arquivo para `.env` (ou defina as variáveis diretamente no
# ambiente) e preencha os valores reais. `.env` nunca deve ser commitado —
# já está no .gitignore. O JARVIS lê essas variáveis via
# config/settings.py; nenhuma delas tem valor sensível com default.

# Obrigatória para conectar o ClaudeProvider (https://console.anthropic.com/).
# Sem isso, o JARVIS usa UnavailableAIService automaticamente — funciona
# normalmente, só sem responder mensagens com IA.
ANTHROPIC_API_KEY=

# Opcional — modelo usado pelo ClaudeProvider (padrão: claude-sonnet-5)
JARVIS_ANTHROPIC_MODEL=

# Opcional — timeout em segundos para chamadas à API (padrão: 30)
JARVIS_ANTHROPIC_TIMEOUT=

# Opcional — número máximo de tokens de saída por resposta (padrão: 1024)
JARVIS_ANTHROPIC_MAX_TOKENS=
