# Copie este arquivo para `.env` (ou defina as variáveis diretamente no
# ambiente) e preencha os valores reais. `.env` nunca deve ser commitado —
# já está no .gitignore. O JARVIS lê essas variáveis via config/settings.py;
# nenhuma delas tem valor sensível com default. O Agent SDK não carrega
# arquivos `.env` sozinho — a variável precisa estar no ambiente do processo
# que executa `python main.py`.

# --- Provider de IA (ver docs/providers.md) ---
# Precedência: OPENROUTER_API_KEY > ANTHROPIC_API_KEY > nenhum provider
# (o JARVIS abre e funciona normalmente sem nenhuma das duas).

# Recomendado na v1.0 — usa o ProviderRouter, com controle real de custo
# (free_only ligado por padrão). https://openrouter.ai/
OPENROUTER_API_KEY=

NVIDIA_API_KEY=

GEMINI_API_KEY=

GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Alternativa: Claude Agent SDK (https://platform.claude.com/).
ANTHROPIC_API_KEY=

# Opcional — modelo usado pelo ClaudeAgentProvider: aceita os aliases do
# Agent SDK ("sonnet", "opus", "haiku") ou um nome de modelo completo
# (padrão: sonnet)
JARVIS_AGENT_MODEL=

# Opcional — "0" desliga o modo somente-gratuito. NÃO recomendado: com
# free_only desligado, uma rota paga pode ser usada (ver docs/providers.md).
JARVIS_FREE_ONLY=1

# Opcional — orçamento de tokens da resposta (padrão 1024). Valores muito
# baixos fazem modelos de raciocínio devolverem texto vazio.
JARVIS_PROVIDER_MAX_TOKENS=

# --- E-mail (verificação de conta — ver docs/security.md) ---
# Sem JARVIS_SMTP_HOST e JARVIS_EMAIL_FROM, o JARVIS não envia e NÃO finge
# ter enviado: a verificação reporta EMAIL_SERVICE_NOT_CONFIGURED e a conta
# continua utilizável. A senha SMTP só existe no ambiente — nunca em
# arquivo versionado, nunca no banco.
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=
JARVIS_SMTP_USERNAME=
JARVIS_SMTP_PASSWORD=
JARVIS_SMTP_USE_TLS=
JARVIS_EMAIL_FROM=
